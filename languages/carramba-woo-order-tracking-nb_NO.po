msgid "Carramba WooCommerce Order Tracking"
msgstr "Carramba WooCommerce Ordresporing"

msgid "requires WooCommerce to be installed and active."
msgstr "krever at WooCommerce er installert og aktivert."

#. translators: %s: Customer first name
msgid "Hi %s,"
msgstr "Hei %s,"

msgid "Your order has been shipped! Here is the tracking information:"
msgstr "Din ordre er sendt! Her er sporingsinformasjonen:"

msgid "Shipping Company:"
msgstr "Fraktselskap:"

msgid "Tracking Number:"
msgstr "Sporingsnummer:"

#. translators: %s: tracking number
msgid "Track %s"
msgstr "Spor %s"

#. translators: %s: Order number
msgid "[Order #%s]"
msgstr "[Ordre #%s]"

msgid "Tracking Information"
msgstr "Sporingsinformasjon"

msgid "Track Your Package:"
msgstr "Spor pakken din:"

msgid "ORDER #%s"
msgstr "ORDRE #%s"

msgid "Order Tracking"
msgstr "Ordresporing"

msgid "Order Tracking Information"
msgstr "Ordresporingsinformasjon"

msgid "This email is sent to customers when tracking information is added to their order."
msgstr "Denne e-posten sendes til kunder nar sporingsinformasjon legges til bestillingen deres."

msgid "Your Order Tracking Information"
msgstr "Din ordresporingsinformasjon"

msgid "Tracking information for your order #{order_number}"
msgstr "Sporingsinformasjon for din ordre #{order_number}"

msgid "Thanks for shopping with us."
msgstr "Takk for at du handler hos oss."

msgid "Available placeholders: %s"
msgstr "Tilgjengelige plassholdere: %s"

msgid "Enable/Disable"
msgstr "Aktiver/Deaktiver"

msgid "Enable this email notification"
msgstr "Aktiver denne e-postvarslingen"

msgid "Subject"
msgstr "Emne"

msgid "Email heading"
msgstr "E-postoverskrift"

msgid "Additional content"
msgstr "Tilleggsinnhold"

msgid "Text to appear below the main email content."
msgstr "Tekst som vises under hovedinnholdet i e-posten."

msgid "N/A"
msgstr "Ikke tilgjengelig"

msgid "Email type"
msgstr "E-posttype"

msgid "Choose which format of email to send."
msgstr "Velg hvilket format e-posten skal sendes i."

msgid "Settings saved successfully."
msgstr "Innstillingene ble lagret."

msgid "Please fill in all required fields."
msgstr "Vennligst fyll ut alle obligatoriske felt."

msgid "Tracking URL must contain {tracking_number} placeholder."
msgstr "Sporings-URL ma inneholde {tracking_number} plassholder."

msgid "Shipper saved successfully."
msgstr "Fraktselskapet ble lagret."

msgid "Failed to save shipper."
msgstr "Kunne ikke lagre fraktselskapet."

msgid "Shipper deleted successfully."
msgstr "Fraktselskapet ble slettet."

msgid "Failed to delete shipper."
msgstr "Kunne ikke slette fraktselskapet."

msgid "Add New Shipper"
msgstr "Legg til nytt fraktselskap"

msgid "Shipper not found"
msgstr "Fraktselskap ikke funnet"

msgid "Edit Shipper"
msgstr "Rediger fraktselskap"

msgid "Shipper:"
msgstr "Fraktselskap:"

msgid "Select a shipper..."
msgstr "Velg et fraktselskap..."

msgid "Tracking Numbers:"
msgstr "Sporingsnumre:"

msgid "Enter tracking number"
msgstr "Skriv inn sporingsnummer"

msgid "Remove"
msgstr "Fjern"

msgid "+ Add Another Tracking Number"
msgstr "+ Legg til et sporingsnummer"

msgid "Tracking Links:"
msgstr "Sporingslenker:"

msgid "Send tracking email to customer"
msgstr "Send sporings-e-post til kunden"

msgid "Save Tracking"
msgstr "Lagre sporing"

msgid "Saving..."
msgstr "Lagrer..."

msgid "Saved!"
msgstr "Lagret!"

msgid "Error saving."
msgstr "Feil ved lagring."

msgid "Tracking"
msgstr "Sporing"

msgid "Track package"
msgstr "Spor pakke"

msgid "Invalid shipper"
msgstr "Ugyldig fraktselskap"

msgid "No tracking"
msgstr "Ingen sporing"

msgid "Security check failed."
msgstr "Sikkerhetssjekk mislyktes."

msgid "You do not have permission to perform this action."
msgstr "Du har ikke tillatelse til a utfore denne handlingen."

msgid "Invalid order ID."
msgstr "Ugyldig ordre-ID."

msgid "Order not found."
msgstr "Ordre ikke funnet."

msgid "Tracking information saved successfully."
msgstr "Sporingsinformasjon ble lagret."

msgid "Tracking information saved and email sent successfully."
msgstr "Sporingsinformasjon ble lagret og e-post sendt."

msgid "Tracking information saved but email could not be sent."
msgstr "Sporingsinformasjon ble lagret, men e-posten kunne ikke sendes."

msgid "Shipper Name"
msgstr "Navn pa fraktselskap"

msgid "Enter the name of the shipping company."
msgstr "Skriv inn navnet pa fraktselskapet."

msgid "Tracking URL"
msgstr "Sporings-URL"

msgid "Enter the tracking URL template. Use {tracking_number} as placeholder for the tracking number."
msgstr "Skriv inn sporings-URL-malen. Bruk {tracking_number} som plassholder for sporingsnummeret."

msgid "Example: https://www.dhl.com/en/express/tracking.html?AWB={tracking_number}"
msgstr "Eksempel: https://www.dhl.com/en/express/tracking.html?AWB={tracking_number}"

msgid "Status"
msgstr "Status"

msgid "Active"
msgstr "Aktiv"

msgid "Inactive"
msgstr "Inaktiv"

msgid "Update Shipper"
msgstr "Oppdater fraktselskap"

msgid "Add Shipper"
msgstr "Legg til fraktselskap"

msgid "Cancel"
msgstr "Avbryt"

msgid "Name"
msgstr "Navn"

msgid "Actions"
msgstr "Handlinger"

msgid "Edit"
msgstr "Rediger"

msgid "Are you sure you want to delete this shipper?"
msgstr "Er du sikker pa at du vil slette dette fraktselskapet?"

msgid "Delete"
msgstr "Slett"

msgid "No shippers found."
msgstr "Ingen fraktselskaper funnet."

msgid "Order Tracking Settings"
msgstr "Innstillinger for ordresporing"

msgid "Settings"
msgstr "Innstillinger"

msgid "Shippers"
msgstr "Fraktselskaper"

msgid "Display Options"
msgstr "Visningsalternativer"

msgid "Show tracking information on customer order details page"
msgstr "Vis sporingsinformasjon pa kundens ordredetaljside"

msgid "Show tracking information in customer email notifications"
msgstr "Vis sporingsinformasjon i kundens e-postvarsler"

msgid "Control where tracking information is displayed to customers."
msgstr "Kontroller hvor sporingsinformasjon vises til kunder."

msgid "Save Settings"
msgstr "Lagre innstillinger"
